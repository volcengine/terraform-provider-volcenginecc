      "description": "Alert template rule list",
      "insertionOrder": false,
      "items": {
        "$ref": "#/definitions/TemplateRule",
        "description": "Alert template rule"
      },
      "type": "array",
      "uniqueItems": false
    },
    "UpdatedAt": {
      "description": "Update time",
      "semantic": "updatedTime",
      "type": "string"
    }
  },
  "readOnlyProperties": [
