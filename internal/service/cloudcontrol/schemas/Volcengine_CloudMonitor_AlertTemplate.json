    "filterableProperties": [
      "/properties/TemplateId",
      "/properties/Name",
      "/properties/ObjectGroups/*/ObjectGroupId",
      "/properties/TemplateRules/*/Namespace"
    ]
  },
  "handlers": {
    "create": {
      "permissions": [
        "cloudmonitor:CreateAlertTemplate",
        "cloudmonitor:ApplyObjectGroupsByAlertTemplate",
        "cloudmonitor:ListAlertTemplates"
      ]
    },
    "delete": {
      "permissions": [
        "cloudmonitor:DeleteAlertTemplatesByIds",
        "cloudmonitor:ListAlertTemplates"
      ]
    },
    "list": {
      "permissions": [
        "cloudmonitor:ListAlertTemplates"
      ]
    },
    "read": {
      "permissions": [
        "cloudmonitor:ListAlertTemplates"
      ]
    },
    "update": {
      "permissions": [
        "cloudmonitor:UpdateAlertTemplate",
        "cloudmonitor:ApplyObjectGroupsByAlertTemplate",
        "cloudmonitor:ListAlertTemplates"
      ]
    }
  },
