  "description": "Cloud Security Center (seccenter) Host Security Agent resource. Represents a security protection Agent on a host, uniquely identified by AgentID. Create means installing/enabling host security protection (InstallAgentClient) on an existing AgentID. Delete means uninstalling/disabling the Agent (UninstallAgentClient). Reading and listing are performed via ListOrderedHostsBasicInfos.",
  "filterProperties": {
    "filterableProperties": [
      "/properties/AgentID"
    ]
  },
  "handlers": {
    "create": {
      "permissions": [
        "seccenter:InstallAgentClient",
        "seccenter:ListOrderedHostsBasicInfos",
        "seccenter:GetAutoProtectConfig"
      ]
    },
    "delete": {
      "permissions": [
        "seccenter:UninstallAgentClient"
      ]
    },
    "list": {
      "permissions": [
        "seccenter:ListOrderedHostsBasicInfos"
      ]
    },
    "read": {
      "permissions": [
