  "description": "Branch resources under the TiDB cluster, corresponding to the branches object",
  "filterProperties": {
    "filterableProperties": [
      "/properties/ClusterId"
    ],
    "required": [
      "/properties/ClusterId"
    ]
  },
  "handlers": {
    "create": {
      "permissions": [
        "tidb:CreateBranch",
        "tidb:ChangeBranchPassword",
        "tidb:GetBranchDetails"
      ]
    },
    "delete": {
      "permissions": [
        "tidb:DeleteBranch",
        "tidb:GetBranchDetails"
      ]
    },
    "list": {
      "permissions": [
        "tidb:ListBranches"
      ]
    },
    "read": {
      "permissions": [
        "tidb:GetBranchDetails"
      ]
    },
    "update": {
      "permissions": [
        "tidb:UpdateBranch",
        "tidb:ChangeBranchPassword",
        "tidb:ResetBranch",
        "tidb:GetBranchDetails"
      ]
    }
  },
  "primaryIdentifier": [
    "/properties/ClusterId",
    "/properties/BranchId"
  ],
  "properties": {
    "Annotations": {
      "description": "Annotation",
      "insertionOrder": false,
      "items": {
        "$ref": "#/definitions/BranchAnnotation"
      },
      "type": "array",
      "uniqueItems": true
    },
    "BranchId": {
      "description": "Branch ID, assigned by the creation API",
      "semantic": "resourceId",
      "type": "string"
    },
    "ClusterId": {
      "description": "Cluster ID",
      "type": "string"
    },
    "CreateTime": {
      "description": "Creation time",
      "semantic": "createdTime",
      "type": "string"
    },
    "CreatedBy": {
      "description": "Creator identifier",
      "type": "string"
    },
    "DisplayName": {
      "description": "Branch display name",
      "semantic": "resourceName",
      "type": "string"
    },
    "Endpoints": {
      "$ref": "#/definitions/Endpoints",
      "description": "Branch endpoint configuration"
    },
    "HasSetPwd": {
      "description": "Root password set",
      "type": "boolean"
    },
    "Name": {
      "description": "Branch resource name",
      "type": "string"
    },
    "ParentDisplayName": {
      "description": "Parent branch display name",
      "type": "string"
    },
    "ParentId": {
      "description": "Parent branch ID",
      "type": "string"
    },
    "ParentTimestamp": {
      "description": "Timestamp of derivation from the parent branch",
      "type": "string"
    },
    "Password": {
      "description": "Branch root password, only for setting or changing the password (not returned after writing)",
      "type": "string"
    },
    "ProjectName": {
      "description": "Name of the project to which the IP address pool belongs",
      "semantic": "projectName",
      "type": "string"
    },
    "ResetBranch": {
      "description": "Reset branch. Resetting briefly changes the branch status before returning to READY; only used to trigger actions (no return value)",
      "type": "boolean"
    },
    "State": {
      "description": "Branch status (e.g., CREATING, READY)",
      "semantic": "status",
      "type": "string"
    },
    "UpdateTime": {
      "description": "Update time",
      "semantic": "updatedTime",
      "type": "string"
    },
    "Usages": {
      "$ref": "#/definitions/BranchUsages",
      "description": "Branch resource usage"
    },
    "UserPrefix": {
      "description": "Default username prefix",
      "type": "string"
    }
